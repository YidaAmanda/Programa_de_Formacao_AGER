# Configuração local da API (copie para .env)
# Estes valores batem com o docker-compose.yml da raiz (pnpm db:up)

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=codeconnect
DB_PASSWORD=codeconnect
DB_NAME=codeconnect

# Segredo do JWT (troque em produção)
JWT_SECRET=dev-secret-change-me

# Porta da API
PORT=3000
